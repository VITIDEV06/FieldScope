# Paths relative to backend/, unless absolute. Never commit your .env.
DATABASE_URL=sqlite:///./data/installed_base.db
QVAC_MODEL=QWEN3_600M_INST_Q4
QVAC_ASR_MODEL=WHISPER_TINY
QVAC_CTX_SIZE=4096
QVAC_CACHE_DIR=./data/qvac-cache
QVAC_REQUIRED=true
QVAC_ENABLED=true
QVAC_RPC_INIT_TIMEOUT_MS=120000
QVAC_STARTUP_TIMEOUT_SECONDS=240
QVAC_INFERENCE_TIMEOUT_SECONDS=120
# Optional: absolute path returned by npm root -g, followed by /@qvac/sdk
# QVAC_SDK_DIR=
